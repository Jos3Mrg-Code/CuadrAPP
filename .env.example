# Copia este archivo como .env y rellena los valores de tu proyecto Supabase.
# Estas tres viajan en el bundle del navegador: NO son secretas.
EXPO_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key del proyecto>
EXPO_PUBLIC_VAPID_PUBLIC_KEY=<clave publica VAPID para Web Push>

# Los secretos de verdad NO van aquí: se configuran como secrets de Supabase
# (Dashboard > Edge Functions > Secrets) y nunca tocan el repositorio.
#   SUPABASE_SERVICE_ROLE_KEY  - lo inyecta Supabase automáticamente
#   VAPID_PRIVATE_KEY          - firma las notificaciones push
#   CRON_SECRET                - autoriza al cron a invocar send-reminders
#   ANTHROPIC_API_KEY          - asistente IA (RF-015)
